# Copy this file to .env.local and fill in your real Razorpay keys.
# .env.local is already gitignored — never commit real keys.
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys.
# See PAYMENTS.md for the full step-by-step.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
